<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="112dp"
    android:layout_margin="7dp"
    android:background="@drawable/channel_card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:padding="10dp">

    <ImageView
        android:id="@+id/channelLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerInside" />

    <TextView android:id="@+id/favoriteIndicator" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="top|end" android:textColor="#FBBF24"
        android:textSize="20sp" android:importantForAccessibility="no" />
</FrameLayout>
