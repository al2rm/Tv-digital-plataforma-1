@@ -0,0 +1,42 @@
+package com.tvdigital.player
+
+import android.view.LayoutInflater
+import android.view.ViewGroup
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import com.tvdigital.player.databinding.ItemHomeSectionBinding
+
+class HomeSectionAdapter(
+    private val onChannel: (Channel) -> Unit,
+    private val onFavorite: (Channel) -> Unit,
+    private val onChannelFocused: () -> Unit
+) : RecyclerView.Adapter<HomeSectionAdapter.SectionViewHolder>() {
+    private val sections = mutableListOf<HomeSection>()
+    private val pool = RecyclerView.RecycledViewPool()
+
+    fun submitList(value: List<HomeSection>) {
+        sections.clear()
+        sections.addAll(value)
+        notifyDataSetChanged()
+    }
+
+    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int) = SectionViewHolder(
+        ItemHomeSectionBinding.inflate(LayoutInflater.from(parent.context), parent, false)
+    )
+
+    override fun onBindViewHolder(holder: SectionViewHolder, position: Int) = holder.bind(sections[position])
+    override fun getItemCount() = sections.size
+
+    inner class SectionViewHolder(private val binding: ItemHomeSectionBinding) : RecyclerView.ViewHolder(binding.root) {
+        private val adapter = ChannelAdapter(onChannel, onFavorite, onChannelFocused)
+        init {
+            binding.channelRow.layoutManager = LinearLayoutManager(binding.root.context, RecyclerView.HORIZONTAL, false)
+            binding.channelRow.adapter = adapter
+            binding.channelRow.setRecycledViewPool(pool)
+        }
+        fun bind(section: HomeSection) {
+            binding.sectionTitle.text = section.title
+            adapter.submitList(section.channels)
+        }
+    }
+}
