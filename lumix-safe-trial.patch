+        mimeType.equals(MPEG_TS_MIME_TYPE, ignoreCase = true) || MPEG_TS_SUFFIX.containsMatchIn(manifestUrl) -> "TS"
+        mimeType.equals("application/dash+xml", ignoreCase = true) -> "DASH"
+        else -> "Automático"
     }
 
