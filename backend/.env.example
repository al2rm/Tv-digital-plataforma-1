NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tv_digital
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave

JWT_SECRET=genera_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# assisted: prepara enlaces wa.me para envío humano.
# cloud: envía mediante la API oficial de WhatsApp Cloud.
WHATSAPP_MODE=assisted
WHATSAPP_DEFAULT_COUNTRY_CODE=595
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

AUTOMATION_WORKER_ENABLED=false
AUTOMATION_WORKER_INTERVAL_MS=60000
AUTOMATION_WORKER_BATCH_SIZE=20

# Solo para ejecutar `npm run admin:create`.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
